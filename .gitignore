# INTERNAL PLUGINS (experimental; source is tracked, never packaged).
# The source is visible in this repository, but every packaging input
# excludes it, so a built app ships none of it. Runtime state stays
# ignored by tools/internal_plugins/.gitignore; the exclusion guard is
# tests/tauri/test_internal_plugin_tools_absent.py.
# Local archive of the retired nested plugin repo's .git directory.
.internal-plugins-git-archive/

# Agent-tooling directories are local development infrastructure, not
# product. Untracked so the shipped repo contains only product code
# (tracked before this entry: `.Skills/` 75 files, `.agents/` 6 files,
# `.workbuddy-ai/` 1 file incl. session memory notes).
# NOTE: adding these here does NOT untrack already-tracked files — the owner
# must run `git rm --cached -r .Skills .agents .workbuddy-ai` (agents may
# not run `git rm`, AGENTS.md E18).
.Skills/
.agents/
.workbuddy-ai/

# Nested git worktrees created by tooling (e.g. .kilo/worktrees/*). Leaving
# a 2,830-file duplicate checkout un-ignored doubles every filesystem-wide
# grep/tool result without showing up in `git status`.
.kilo/

website/.taste-skill/
