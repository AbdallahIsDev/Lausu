{
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.css",
			"!out",
			"!**/dist",
			"!**/node_modules",
			"!**/data/hotkey_reserved.json",
			"!**/coverage",
			"!vitest-failures.json",
			"!wip-failures.json"
		]
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": [
				"src/renderer/src/components/ui/date-range-picker.tsx",
				"src/renderer/src/components/ui/date-range-picker-utils/date-range-picker.module.css"
			],
			"linter": { "enabled": false }
		}
	]
}
