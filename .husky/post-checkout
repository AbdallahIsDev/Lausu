#!/usr/bin/env sh
# Husky post-checkout hook — refresh the local CI error digest after a
# checkout/branch switch. User-level script sourced by .husky/_/post-checkout
# (husky v9 single-installer architecture). The only logic here is the
# best-effort backgrounded sync below; it can never fail the checkout.

# ── CI-errors sync (best effort, never blocks / never fails the hook) ──────
# Backgrounded and output-discarded: adds ~0ms to the hook. The script's own
# --timeout 3 bounds the child so no stale process lingers. Offline is silent.
(
  _sync_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
  cd "$_sync_root" || exit 0
  if [ -x .venv/Scripts/python.exe ]; then
    _sync_py=.venv/Scripts/python.exe
  elif [ -x .venv/bin/python ]; then
    _sync_py=.venv/bin/python
  elif command -v python3 >/dev/null 2>&1; then
    _sync_py=python3
  else
    _sync_py=python
  fi
  "$_sync_py" scripts/sync_ci_errors.py --timeout 3 >/dev/null 2>&1 || :
) >/dev/null 2>&1 &
